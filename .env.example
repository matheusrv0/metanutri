# Conta na nuvem (opcional). Sem estas chaves o MetaNutri funciona inteiro,
# só não existe login: os dados ficam salvos no navegador.
#
# Como conseguir:
#   1. Crie um projeto em https://supabase.com (plano gratuito serve)
#   2. Project Settings > API
#   3. Copie "Project URL" e a chave "anon public"
#   4. Copie este arquivo para .env.local e cole os valores
#   5. Reinicie o `npm run dev`
#
# A chave anon é pública por natureza (vai no navegador). Nunca ponha aqui a
# service_role: essa dá acesso total ao banco.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Pagamento com cartão (spec checkout-proprio, D-72): a chave PÚBLICA da operadora de
# pagamento (Mercado Pago > Suas integrações > a aplicação > Credenciais > Public Key).
# Ela vai no navegador de propósito: é o que abre os campos seguros do cartão. Use a de
# teste junto com o token de teste do servidor, e a de produção junto com o de produção.
# Sem ela, o checkout mostra "O pagamento não está disponível agora." (CB-89).
VITE_MERCADOPAGO_PUBLIC_KEY=
